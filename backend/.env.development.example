NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dev auth profile (RS256 only)
JWT_ALLOWED_ALGS=RS256
# Escape line breaks with \n when storing PEM in .env files.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_RSA_PUBLIC_KEY\n-----END PUBLIC KEY-----"
JWT_ISSUER=slotsone-dev
JWT_AUDIENCE=slotsone-client

# Atlassian 2FA helper — IMAP credentials for the guest mailbox.
# Leave UKR_IMAP_USER / UKR_IMAP_PASSWORD blank to disable the watcher.
# UKR_IMAP_PASSWORD is the dedicated IMAP password from accounts.ukr.net,
# NOT the web login password.
UKR_IMAP_HOST=imap.ukr.net
UKR_IMAP_PORT=993
UKR_IMAP_USER=
UKR_IMAP_PASSWORD=
