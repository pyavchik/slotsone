#!/usr/bin/env bash
set -euo pipefail

ref_updates="$(cat)"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  # Temporary override for emergency/manual admin pushes.
  if [[ "${remote_ref}" == "refs/heads/main" && "${ALLOW_MAIN_PUSH:-0}" != "1" ]]; then
    cat >&2 <<'EOF'
Push blocked: direct pushes to "main" are disabled for this repository.
Use a feature branch and open a pull request instead.

Temporary override (one command only):
  ALLOW_MAIN_PUSH=1 git push <remote> <ref>
EOF
    exit 1
  fi
done <<< "$ref_updates"

if ! command -v git-lfs >/dev/null 2>&1; then
  echo 'Git LFS is required to push this repository. Install it from https://git-lfs.com/.' >&2
  exit 1
fi

git lfs pre-push "$@" <<< "$ref_updates"
